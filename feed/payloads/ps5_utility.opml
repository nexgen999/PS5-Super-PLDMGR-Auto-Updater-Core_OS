    <outline text="PoorDS4" title="PoorDS4" type="rss" xmlUrl="https://github.com/ItsBlurf/PoorDS4" author="ItsBlurf" description="PoorDS4 lets a wireless DualShock 4 paired with a jailbroken PS5."/>
    <outline text="PS Game State Lib" title="PS Game State Lib" type="rss" xmlUrl="https://github.com/StonedModder/ps-game-state-lib" author="StonedModder" description="Standalone PS5 game-state detection payload - webui ps5ip:9877 ."/>
