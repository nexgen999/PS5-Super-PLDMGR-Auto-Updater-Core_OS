{
  "site": {
    "name": "My GitHub Dashboard",
    "shortName": "MySite",
    "tagline": "A configurable repository dashboard",
    "language": "fr",
    "defaultPage": "home",
    "theme": "dark"
  },
  "autoDetect": {
    "enabled": true,
    "githubPages": true,
    "owner": true,
    "repository": true,
    "branch": "auto"
  },
  "repository": {
    "owner": "",
    "name": "",
    "branch": "auto"
  },
  "paths": {
    "jsonDir": "/json/",
    "rssDir": "/rss/",
    "docsDir": "/docs/",
    "archivesDir": "/archives/"
  },
  "navigation": [
    {
      "id": "home",
      "label": "Home",
      "icon": "home",
      "enabled": true
    },
    {
      "id": "news",
      "label": "News",
      "icon": "rss",
      "enabled": true
    },
    {
      "id": "downloads",
      "label": "Download",
      "icon": "download",
      "enabled": true
    },
    {
      "id": "store",
      "label": "Store",
      "icon": "store",
      "enabled": true
    },
    {
      "id": "thanks",
      "label": "Thanks",
      "icon": "heart",
      "enabled": true
    },
    {
      "id": "services",
      "label": "Services",
      "icon": "link",
      "enabled": true
    },
    {
      "id": "about",
      "label": "About",
      "icon": "info",
      "enabled": true
    },
    {
      "id": "docs",
      "label": "Documentation",
      "icon": "book",
      "enabled": true
    }
  ],
  "news": {
    "enabled": true,
    "autoDiscover": true,
    "feeds": []
  },
  "downloads": {
    "enabled": true,
    "search": true,
    "items": []
  },
  "store": {
    "enabled": true,
    "autoDiscover": true,
    "sources": []
  },
  "docs": {
    "enabled": true,
    "root": "/docs/",
    "source": "github-api",
    "branch": "auto",
    "recursive": true,
    "showTree": true,
    "order": [],
    "hideFiles": []
  },
  "socials": [
    {
      "id": "github",
      "label": "GitHub",
      "url": "",
      "icon": "github",
      "enabled": true
    }
  ],
  "footer": {
    "enabled": true,
    "text": "My GitHub Dashboard",
    "showYear": true,
    "links": [],
    "badges": []
  },
  "advanced": {
    "cacheMinutes": 10,
    "requestTimeoutMs": 12000,
    "githubApiEnabled": true,
    "allowExternalJson": true,
    "allowExternalRss": true
  },
  "themeColors": {
    "accent": "#16c8ff",
    "accent2": "#147cff",
    "background": "#040a12",
    "panel": "#071321",
    "panel2": "#091a2c",
    "text": "#eaf7ff",
    "muted": "#83a4ba",
    "line": "#123451",
    "good": "#35e6a1",
    "danger": "#ff668c"
  }
}