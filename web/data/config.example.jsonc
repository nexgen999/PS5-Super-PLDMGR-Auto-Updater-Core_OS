{
  // ==============================================================
  // evoX Core OS — CONFIGURATION EXAMPLE
  // Ce fichier est volontairement en JSONC (commentaires autorisés)
  // et sert de documentation. Le site charge config.json.
  // Copiez les valeurs utiles dans config.json.
  // ==============================================================
  "site": {
    "name": "evoX Core OS",
    "shortName": "evoX",
    "tagline": "One place. All your tools.",
    "language": "fr",
    "defaultPage": "home",
    "accent": "cyan",
    "theme": "dark"
  },

  // --- AUTO-DETECTION -------------------------------------------
  // Sur GitHub Pages, https://USER.github.io/REPO/ permet de déduire
  // owner=USER et repository=REPO. Laissez les champs vides.
  // Sur un domaine personnalisé, renseignez owner/name manuellement.
  "autoDetect": {
    "enabled": true,
    "githubPages": true,
    "repository": true,
    "owner": true,
    "branch": "auto"
  },
  "repository": {
    "owner": "",
    "name": "",
    "branch": "auto",
    "baseUrl": "",
    "githubUrl": "",
    "pagesUrl": "",
    "apiBase": "https://api.github.com"
  },

  // --- CHEMINS ---------------------------------------------------
  // Les chemins relatifs commencent par / à la racine du dépôt.
  // Ils peuvent être remplacés par une URL complète externe.
  "paths": {
    "jsonDir": "/json/",
    "rssDir": "/rss/",
    "docsDir": "/docs/",
    "assetsDir": "/web/assets/",
    "archivesDir": "/archives/"
  },

  // --- PROFIL GITHUB ---------------------------------------------
  // avatar/bio/location/profileUrl peuvent être forcés.
  // Sinon l'API GitHub fournit automatiquement ces données.
  "profile": {
    "enabled": true,
    "showAvatar": true,
    "showBio": true,
    "showLocation": true,
    "showStats": true,
    "avatar": "",
    "bioFallback": "Votre bio si GitHub n'est pas accessible.",
    "locationFallback": "",
    "profileUrl": ""
  },

  // --- BRANDING --------------------------------------------------
  // heroImage peut être une image locale ou une URL externe.
  "branding": {
    "logo": "./web/assets/logo.svg",
    "favicon": "./web/assets/favicon.svg",
    "heroImage": "",
    "heroTitle": "Bienvenue sur evoX Core OS",
    "heroText": "Votre texte de présentation.",
    "heroTags": ["Open Source", "GitHub", "Dynamic Store"]
  },

  // --- MENU PRINCIPAL --------------------------------------------
  // id = identifiant technique, label = texte, icon = icône intégrée.
  // Vous pouvez désactiver un menu avec enabled:false.
  "navigation": [
    {"id":"home","label":"Home","icon":"home","enabled":true},
    {"id":"news","label":"News","icon":"rss","enabled":true},
    {"id":"downloads","label":"Download","icon":"download","enabled":true},
    {"id":"store","label":"Store","icon":"store","enabled":true},
    {"id":"thanks","label":"Remerciements","icon":"heart","enabled":true},
    {"id":"services","label":"Services","icon":"link","enabled":true},
    {"id":"about","label":"About","icon":"info","enabled":true},
    {"id":"docs","label":"Documentation","icon":"book","enabled":true}
  ],

  // --- NEWS / RSS ------------------------------------------------
  // Chaque feed peut être interne (/rss/...) ou externe (https://...).
  // Un flux externe doit autoriser CORS pour être lu directement
  // depuis GitHub Pages, ou passer par votre propre proxy.
  "news": {
    "enabled": true,
    "maxItems": 12,
    "openExternal": true,
    "autoDiscover": true,\n    "feeds": [
      {"id":"payloads","label":"Payloads","url":"/rss/payloads_rss.xml","enabled":true},
      {"id":"pkg","label":"Packages","url":"/rss/pkg_rss.xml","enabled":true}
    ]
  },

  // --- DOWNLOADS -------------------------------------------------
  // Cette liste est entièrement configurable. url peut être locale
  // ou externe. Aucun serveur n'est nécessaire.
  "downloads": {
    "enabled": true,
    "search": true,
    "items": [
      {
        "name":"Mon pack",
        "description":"Description",
        "filename":"archive.zip",
        "category":"Tools",
        "url":"/archives/archive.zip"
      }
    ]
  },

  // --- STORE JSON ------------------------------------------------
  // Ajoutez autant de sources JSON que nécessaire.
  // arrayKeys permet au moteur de trouver le tableau dans différents
  // formats. fieldMap permet de mapper vos propres noms de propriétés.
  "store": {
    "enabled": true,
    "search": true,
    "layout": "list",
    "pageSize": 30,
    "autoDiscover": true,\n    "sources": [
      {
        "id":"payloads",
        "label":"Payloads",
        "type":"json",
        "url":"/json/payloads.json",
        "arrayKeys":["payloads","items","data"]
      }
    ],
    "fieldMap": {
      "name":["name","title","filename"],
      "filename":["filename","file","name"],
      "url":["url","download","download_url","href"],
      "description":["description","desc","summary"],
      "version":["version","ver"],
      "author":["author","developer","creator"],
      "category":["category","type","group"],
      "subcategory":["subcategory","sub_category","subCategory"],
      "icon":["icon","image","logo"],
      "checksum":["checksum","sha256","sha-256"]
    },
    "subcategory": {
      "enabled": true,
      "inferFromPath": true,
      "pathSegments": 1
    }
  },

  // --- DOCUMENTATION ---------------------------------------------
  // Le moteur utilise l'API GitHub pour parcourir /docs/ récursivement.
  // order contient les chemins relatifs à /docs/ à placer en premier.
  // Les fichiers non listés restent ensuite dans l'ordre alphabétique.
  "docs": {
    "enabled": true,
    "root": "/docs/",
    "source": "github-api",
    "branch": "auto",
    "recursive": true,
    "showTree": true,
    "order": ["README.md", "getting-started.md"],
    "hideFiles": [],
    "homeDocument": "README.md",
    "rawFallback": true
  },

  // --- RESEAUX SOCIAUX -------------------------------------------
  // icon = icône intégrée. Pour une icône personnalisée, utilisez
  // iconType:"image" et icon:"/web/assets/mon-icone.svg" (ou .png/.ico).
  "socials": [
    {"id":"github","label":"GitHub","url":"","icon":"github","enabled":true},
    {"id":"x","label":"X","url":"https://x.com/","icon":"x","enabled":true},
    {"id":"custom","label":"Mon réseau","url":"https://example.com","iconType":"image","icon":"/web/assets/custom.svg","enabled":true}
  ],

  // --- FOOTER + BADGES -------------------------------------------
  // Les badges acceptent n'importe quelle image URL (shields.io,
  // GitHub, votre propre SVG/PNG, etc.) et n'importe quel lien.
  "footer": {
    "enabled": true,
    "text": "Votre texte de footer",
    "showYear": true,
    "links": [
      {"label":"GitHub","url":"https://github.com/","newTab":true}
    ],
    "badges": [
      {
        "label":"License",
        "href":"https://github.com/",
        "image":"https://img.shields.io/badge/custom-badge-111827?style=for-the-badge",
        "alt":"Badge personnalisé"
      }
    ]
  },

  // --- AVANCE ----------------------------------------------------
  "advanced": {
    "cacheMinutes": 10,
    "requestTimeoutMs": 12000,
    "githubApiEnabled": true,
    "allowExternalJson": true,
    "allowExternalRss": true
  }
}
