  "about": {
    "title": "À propos",
    "text": "evoX Core OS est une interface statique configurable destinée à transformer un dépôt GitHub en portail web dynamique.",
    "cards": [
      {
        "title": "100% statique",
        "text": "Compatible GitHub Pages sans backend."
      },
      {
        "title": "Config-first",
        "text": "Les sources, textes, couleurs, menus et badges sont centralisés dans un seul fichier."
      },
      {
        "title": "Auto-détection",
        "text": "Le dépôt et l'utilisateur GitHub sont détectés depuis l'URL de la page."
      }
    ]
  },
  "docs": {
    "enabled": true,
    "root": "/docs/",
    "source": "github-api",
    "branch": "auto",
    "recursive": true,
    "showTree": true,
    "order": [
      "README.md"
    ],
    "hideFiles": [],
    "homeDocument": "README.md",
    "rawFallback": true
  },
